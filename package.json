{
  "name": "nagi-memo",
  "version": "1.0.0",
  "description": "nagi memo — 데스크탑 스티커 메모 앱",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "gen-icons": "node scripts/gen-icon.js"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.nagi.memo",
    "productName": "nagi memo",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "icon": "assets/icon.png"
    }
  }
}
